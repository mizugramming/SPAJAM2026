{
  "name": "tsunagun-room-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port 8787",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "tsx test/integration.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260926.1",
    "@types/node": "24.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "wrangler": "4.141.0"
  }
}
