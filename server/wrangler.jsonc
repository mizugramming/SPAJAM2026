{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tsunagun-rooms",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-26",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomObject" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomObject"] }],
  "observability": { "enabled": false },
}
